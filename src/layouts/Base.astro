---
import '../styles/global.css';
import { SITE } from '../site';
import ChatButton from '../components/ChatButton.astro';
import { ui, langs, path, htmlLang, ogLocale, formatDate, type Lang, type Page } from '../i18n/ui';

interface Props {
  lang: Lang;
  page: Page;
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
}

const { lang, page, title, description, ogImage = '/images/og-photo.jpg', jsonLd } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'en' ? 'es' : 'en';
const canonical = new URL(path(lang, page), SITE.url).href;
const fullTitle = page === '' ? title : `${title} · ${SITE.name}`;
const navItems: { page: Page; label: string }[] = [
  { page: 'work', label: t.nav.work },
  { page: 'consulting', label: t.nav.consulting },
  { page: 'lab', label: t.nav.lab },
  { page: 'art', label: t.nav.art },
  { page: 'about', label: t.nav.about },
];
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={new URL(path(l, page), SITE.url).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(path('en', page), SITE.url).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#faf7f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131211" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, SITE.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[other]} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {SITE.umami && <script is:inline src={SITE.umamiSrc} data-website-id={SITE.umami} defer />}
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={path(lang)}>Carlos Rendón<span>.</span></a>
        <nav class="site-nav" aria-label={lang === 'en' ? 'Main' : 'Principal'}>
          <ul>
            {
              navItems.map((item) => (
                <li>
                  <a href={path(lang, item.page)} aria-current={item.page === page ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li><ChatButton label={t.nav.contact} variant="link" /></li>
          </ul>
        </nav>
        <a class="lang-switch" href={path(other, page)} hreflang={htmlLang[other]} lang={htmlLang[other]}>
          {t.langSwitch}
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p class="footer-line">{t.footer.line}</p>
        <ul>
          <li><a href={path(lang, 'now')}>{t.footer.now}</a></li>
          <li><a href={SITE.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
          <li><a href={SITE.github} rel="me noopener" target="_blank">GitHub</a></li>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        </ul>
        <p class="machine">
          {t.footer.updated}: <time datetime={SITE.updated}>{formatDate(SITE.updated, lang)}</time> · Brisbane
        </p>
      </div>
    </footer>
    {
      /* Conserje chat widget: a one-shot IIFE that reads document.currentScript, so it lives here, once per
         document. It only loads when its backend is configured; otherwise every chat button is a mailto link. */
      SITE.conserje && (
        <script
          is:inline
          src="/conserje.js"
          data-endpoint={SITE.conserje}
          data-site="carlosrendon"
          data-title={t.chat.title}
          data-greeting={t.chat.greeting}
          data-locale={lang}
          data-accent="#b8291f"
          defer
        />
      )
    }
  </body>
</html>
