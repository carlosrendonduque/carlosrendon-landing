---
import Base from '../../layouts/Base.astro';
import ChatButton from '../../components/ChatButton.astro';
import { SITE } from '../../site';
import { path, staticLangPaths, type Lang } from '../../i18n/ui';

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;

const copy = {
  en: {
    title: 'Applied AI consulting',
    description: 'Applied AI with a person in charge: MCP servers, memory and agent orchestration, connected to the systems you already run.',
    eyebrow: 'Bring AI into your team',
    h1: 'Applied AI, with a person in charge',
    lede: 'I connect AI to your knowledge and your systems, for teams that can’t hand a model the final decision. I use these tools every day.',
    offers: [
      {
        name: 'First conversation',
        price: SITE.conserje ? 'Free · 5 min · any time' : 'Free · no obligation',
        body: SITE.conserje
          ? 'Tell my assistant what you’re trying to build. It asks you the right questions and sends me a brief. If we’re a fit, I come back to you.'
          : 'Tell me what you’re trying to build and what’s in the way. If we’re a fit I’ll say what I would do first, and if we’re not I’ll say that too.',
        cta: 'Start now',
        subject: 'Scoping conversation',
        primary: false,
      },
      {
        name: 'Readiness review',
        price: 'AUD 2,500 · 2 weeks',
        body: 'A written review of risks and opportunities, a prioritised roadmap, and a session to walk your team through it. The fee comes off the build.',
        cta: 'Ask about it',
        subject: 'Readiness review',
        primary: true,
      },
      {
        name: 'Build & integrate',
        price: SITE.dayRate ? `From ${SITE.dayRate}/day` : 'Scoped after the review',
        body: 'MCP servers, memory and agent orchestration, connected to the systems you already run and handed over to your team.',
        cta: 'Start a conversation',
        subject: 'Build and integrate',
        primary: false,
      },
    ],
    proofCta: 'See what I’ve built',
  },
  es: {
    title: 'Consultoría en IA aplicada',
    description: 'IA aplicada con una persona al mando: servidores MCP, memoria y orquestación de agentes, conectados a los sistemas que ya tienes.',
    eyebrow: 'Llevar IA a tu equipo',
    h1: 'IA aplicada, con una persona al mando',
    lede: 'Conecto la IA a tu conocimiento y a tus sistemas, para equipos que no pueden dejarle la decisión final a un modelo. Uso estas herramientas todos los días.',
    offers: [
      {
        name: 'Primera conversación',
        price: SITE.conserje ? 'Gratis · 5 min · cuando quieras' : 'Gratis · sin compromiso',
        body: SITE.conserje
          ? 'Cuéntale a mi asistente qué quieres construir. Te hace las preguntas correctas y me manda un resumen. Si encajamos, te respondo yo.'
          : 'Cuéntame qué quieres construir y qué te lo está impidiendo. Si encajamos te digo por dónde empezaría, y si no, también te lo digo.',
        cta: 'Empezar ahora',
        subject: 'Primera conversación',
        primary: false,
      },
      {
        name: 'Diagnóstico',
        price: 'AUD 2.500 · 2 semanas',
        body: 'Una revisión escrita de riesgos y oportunidades, una hoja de ruta priorizada y una sesión para recorrerla con tu equipo. Ese valor se abona a la construcción.',
        cta: 'Preguntar',
        subject: 'Diagnóstico',
        primary: true,
      },
      {
        name: 'Construcción e integración',
        price: SITE.dayRate ? `Desde ${SITE.dayRate}/día` : 'Alcance después del diagnóstico',
        body: 'Servidores MCP, memoria y orquestación de agentes, conectados a los sistemas que ya tienes y entregados a tu equipo.',
        cta: 'Empezar una conversación',
        subject: 'Construcción e integración',
        primary: false,
      },
    ],
    proofCta: 'Ver lo que he construido',
  },
}[lang];

---

<Base lang={lang} page="consulting" title={copy.title} description={copy.description}>
  <section>
    <div class="wrap">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h1 class="measure">{copy.h1}</h1>
      <p class="lede">{copy.lede}</p>
      <div class="grid offers">
        {
          copy.offers.map((o) => (
            <article class:list={['card', { featured: o.primary }]}>
              <span class="status">{o.price}</span>
              <h2 class="offer-name">{o.name}</h2>
              <p>{o.body}</p>
              <div class="card-foot">
                <ChatButton label={o.cta} subject={o.subject} variant={o.primary ? 'primary' : 'ghost'} />
              </div>
            </article>
          ))
        }
      </div>
      <p class="more"><a class="card-link" href={path(lang, 'lab')}>{copy.proofCta}</a></p>
    </div>
  </section>
</Base>

<style>
  .offers {
    margin-top: 2.5rem;
  }
  .offer-name {
    font-size: 1.5rem;
    margin: 0;
  }
  .featured {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }
  .more {
    margin-top: 2.25rem;
  }
</style>
