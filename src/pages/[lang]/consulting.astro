---
import Base from '../../layouts/Base.astro';
import { SITE, mailto } from '../../site';
import { path, staticLangPaths, type Lang } from '../../i18n/ui';

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;

const copy = {
  en: {
    title: 'Consulting',
    description: 'Applied AI for teams that cannot afford to get it wrong: MCP servers, retrieval over your knowledge, human-in-the-loop agents and Salesforce integration.',
    eyebrow: 'Bring AI into your team',
    h1: 'Applied AI for teams that can’t afford to get it wrong',
    lede: 'I help teams put AI to work on real systems: connecting assistants to your knowledge, building agents that ask before they act, and joining it all to Salesforce. I’ve built these systems for myself first, and I run them every day.',
    offers: [
      {
        name: 'Unoffice hours',
        price: 'Free · 30 minutes · online',
        body: 'Bring a question about AI agents, MCP, retrieval or Salesforce and AI. No pitch: we talk, and you leave with a clearer next step.',
        cta: 'Book a call',
        subject: 'Unoffice hours: 30-minute call',
        primary: true,
      },
      {
        name: 'AI & Salesforce readiness review',
        price: 'AUD 2,500 fixed · 2 weeks',
        body: 'I review your plan, your data and your platform, then hand you a written report of risks and opportunities, a prioritised roadmap with effort estimates, and a one-hour walkthrough. You own the result whether or not we keep working together.',
        cta: 'Ask about a review',
        subject: 'Readiness review enquiry',
        primary: false,
      },
      {
        name: 'Build & integrate',
        price: 'Scoped after the review',
        body: 'MCP servers over your knowledge, retrieval pipelines, human-in-the-loop agent workflows, and Salesforce and OmniStudio integration, built to be handed over to your team.',
        cta: 'Start a conversation',
        subject: 'Build and integrate enquiry',
        primary: false,
      },
    ],
    principlesTitle: 'How I work',
    principles: [
      ['The human decides', 'Models propose. Anything that touches money, customers, compliance or personal data goes to a named person first.'],
      ['Fail closed', 'When a credential, a permission or a check is missing, the system stops instead of guessing.'],
      ['Your data stays yours', 'Isolated per client, routed through your own model accounts when you need it, and deleted at the end of the engagement.'],
      ['Evidence over demos', 'Every recommendation comes with a test, a measurement or a working piece you can run.'],
    ],
    proofTitle: 'Things I’ve built',
    proof: 'An MCP server with hybrid retrieval in daily use, a human-in-the-loop control layer for agents, a multi-model editor and an open-source data checker.',
    proofCta: 'See the lab',
  },
  es: {
    title: 'Consultoría',
    description: 'IA aplicada para equipos que no pueden darse el lujo de equivocarse: servidores MCP, recuperación sobre tu conocimiento, agentes con humano en el circuito e integración con Salesforce.',
    eyebrow: 'Llevar IA a tu equipo',
    h1: 'IA aplicada para equipos que no pueden darse el lujo de equivocarse',
    lede: 'Ayudo a equipos a poner la IA a trabajar sobre sistemas reales: conectar asistentes al conocimiento de la empresa, construir agentes que preguntan antes de actuar y unir todo eso con Salesforce. Construí estos sistemas primero para mí, y los uso todos los días.',
    offers: [
      {
        name: 'Unoffice hours',
        price: 'Gratis · 30 minutos · en línea',
        body: 'Trae una pregunta sobre agentes de IA, MCP, recuperación o Salesforce con IA. Sin discurso de venta: conversamos y sales con un siguiente paso más claro.',
        cta: 'Agendar una llamada',
        subject: 'Unoffice hours: llamada de 30 minutos',
        primary: true,
      },
      {
        name: 'Diagnóstico de IA y Salesforce',
        price: 'AUD 2.500 precio fijo · 2 semanas',
        body: 'Reviso tu plan, tus datos y tu plataforma, y te entrego un informe escrito con riesgos y oportunidades, una hoja de ruta priorizada con estimaciones de esfuerzo y una sesión de una hora para recorrerlo. El resultado es tuyo, sigamos trabajando juntos o no.',
        cta: 'Preguntar por el diagnóstico',
        subject: 'Consulta: diagnóstico de IA y Salesforce',
        primary: false,
      },
      {
        name: 'Construcción e integración',
        price: 'Con alcance definido tras el diagnóstico',
        body: 'Servidores MCP sobre tu conocimiento, pipelines de recuperación, flujos de agentes con humano en el circuito e integración con Salesforce y OmniStudio, hechos para entregarse a tu equipo.',
        cta: 'Empezar la conversación',
        subject: 'Consulta: construcción e integración',
        primary: false,
      },
    ],
    principlesTitle: 'Cómo trabajo',
    principles: [
      ['El humano decide', 'Los modelos proponen. Todo lo que toca dinero, clientes, cumplimiento o datos personales pasa primero por una persona con nombre.'],
      ['Fallar cerrado', 'Cuando falta una credencial, un permiso o una verificación, el sistema se detiene en lugar de adivinar.'],
      ['Tus datos siguen siendo tuyos', 'Aislados por cliente, enrutados por tus propias cuentas de modelos cuando lo necesitas, y borrados al terminar el proyecto.'],
      ['Evidencia antes que demos', 'Cada recomendación viene con una prueba, una medición o una pieza funcionando que puedes ejecutar.'],
    ],
    proofTitle: 'Lo que he construido',
    proof: 'Un servidor MCP con recuperación híbrida en uso diario, una capa de control humano para agentes, un editor multi-modelo y un verificador de datos de código abierto.',
    proofCta: 'Ver el laboratorio',
  },
}[lang];

const bookHref = (subject: string, primary: boolean) => (primary && SITE.calUrl ? SITE.calUrl : mailto(subject));
---

<Base lang={lang} page="consulting" title={copy.title} description={copy.description}>
  <section>
    <div class="wrap">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h1 class="measure">{copy.h1}</h1>
      <p class="lede">{copy.lede}</p>
    </div>
  </section>

  <section aria-label={lang === 'en' ? 'Offers' : 'Ofertas'}>
    <div class="wrap grid">
      {
        copy.offers.map((o) => (
          <article class:list={['card', { featured: o.primary }]}>
            <span class="status">{o.price}</span>
            <h2 class="offer-name">{o.name}</h2>
            <p>{o.body}</p>
            <div class="card-foot">
              <a class:list={['btn', o.primary ? 'btn-primary' : 'btn-ghost']} href={bookHref(o.subject, o.primary)}>
                {o.cta}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="principles-title">
    <div class="wrap">
      <h2 id="principles-title">{copy.principlesTitle}</h2>
      <div class="grid">
        {
          copy.principles.map(([h, p]) => (
            <div>
              <h3>{h}</h3>
              <p class="muted">{p}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="wrap"><div class="callout measure">
      <h2>{copy.proofTitle}</h2>
      <p>{copy.proof}</p>
      <a class="card-link" href={path(lang, 'lab')}>{copy.proofCta}</a>
    </div>
    </div>
  </section>
</Base>

<style>
  .offer-name {
    font-size: 1.5rem;
    margin: 0;
  }
  .featured {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }
  .muted {
    color: var(--muted);
  }
</style>
