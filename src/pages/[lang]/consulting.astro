---
import Base from '../../layouts/Base.astro';
import ChatButton from '../../components/ChatButton.astro';
import { path, staticLangPaths, type Lang } from '../../i18n/ui';

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;

const copy = {
  en: {
    title: 'Consulting',
    description: 'Applied AI for teams that can’t afford mistakes: MCP servers, retrieval, agents with human approval, and Salesforce.',
    eyebrow: 'Bring AI into your team',
    h1: 'Applied AI for teams that can’t afford mistakes',
    lede: 'I connect AI to your knowledge and your systems, with a person approving what matters. I use these tools every day.',
    offers: [
      { name: 'Unoffice hours', price: 'Free · 30 min', body: 'Bring one question about AI agents, MCP or Salesforce. Leave with a next step.', cta: 'Book a call', primary: true },
      { name: 'Readiness review', price: 'AUD 2,500 · 2 weeks', body: 'A written review of risks and opportunities, and a prioritised roadmap. Yours to keep.', cta: 'Ask about it', primary: false },
      { name: 'Build & integrate', price: 'Scoped after the review', body: 'MCP servers, retrieval, agent workflows and Salesforce integration, handed over to your team.', cta: 'Start a conversation', primary: false },
    ],
    principlesTitle: 'How I work',
    principles: [
      ['The human decides', 'Anything touching money, customers or personal data goes to a person first.'],
      ['Fail closed', 'If a check is missing, the system stops instead of guessing.'],
      ['Your data stays yours', 'Isolated per client and deleted at the end.'],
    ],
    proofCta: 'See what I’ve built',
  },
  es: {
    title: 'Consultoría',
    description: 'IA aplicada para equipos que no pueden equivocarse: servidores MCP, recuperación, agentes con aprobación humana y Salesforce.',
    eyebrow: 'Llevar IA a tu equipo',
    h1: 'IA aplicada para equipos que no pueden equivocarse',
    lede: 'Conecto la IA con tu conocimiento y tus sistemas, con una persona aprobando lo que importa. Uso estas herramientas todos los días.',
    offers: [
      { name: 'Unoffice hours', price: 'Gratis · 30 min', body: 'Trae una pregunta sobre agentes de IA, MCP o Salesforce. Sal con un siguiente paso.', cta: 'Agendar llamada', primary: true },
      { name: 'Diagnóstico', price: 'AUD 2.500 · 2 semanas', body: 'Una revisión escrita de riesgos y oportunidades, y una hoja de ruta priorizada. Es tuya.', cta: 'Preguntar', primary: false },
      { name: 'Construcción e integración', price: 'Alcance tras el diagnóstico', body: 'Servidores MCP, recuperación, flujos de agentes e integración con Salesforce, entregados a tu equipo.', cta: 'Empezar la conversación', primary: false },
    ],
    principlesTitle: 'Cómo trabajo',
    principles: [
      ['El humano decide', 'Todo lo que toca dinero, clientes o datos personales pasa primero por una persona.'],
      ['Fallar cerrado', 'Si falta una verificación, el sistema se detiene en vez de adivinar.'],
      ['Tus datos son tuyos', 'Aislados por cliente y borrados al terminar.'],
    ],
    proofCta: 'Ver lo que he construido',
  },
}[lang];

---

<Base lang={lang} page="consulting" title={copy.title} description={copy.description}>
  <section>
    <div class="wrap">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h1 class="measure">{copy.h1}</h1>
      <p class="lede">{copy.lede}</p>
      <div class="grid offers">
        {
          copy.offers.map((o) => (
            <article class:list={['card', { featured: o.primary }]}>
              <span class="status">{o.price}</span>
              <h2 class="offer-name">{o.name}</h2>
              <p>{o.body}</p>
              <div class="card-foot">
                <ChatButton label={o.cta} variant={o.primary ? 'primary' : 'ghost'} />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section aria-labelledby="principles-title">
    <div class="wrap">
      <h2 id="principles-title">{copy.principlesTitle}</h2>
      <div class="grid">
        {
          copy.principles.map(([h, p]) => (
            <div>
              <h3>{h}</h3>
              <p class="muted">{p}</p>
            </div>
          ))
        }
      </div>
      <p class="more"><a class="card-link" href={path(lang, 'lab')}>{copy.proofCta}</a></p>
    </div>
  </section>
</Base>

<style>
  .offers {
    margin-top: 2.5rem;
  }
  .offer-name {
    font-size: 1.5rem;
    margin: 0;
  }
  .featured {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }
  .muted {
    color: var(--muted);
  }
  .more {
    margin-top: 2rem;
  }
</style>
