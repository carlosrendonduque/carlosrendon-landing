---
import Base from '../../layouts/Base.astro';
import { cases, experience, certifications, labProjects } from '../../data/content';
import { SITE } from '../../site';
import { staticLangPaths, type Lang } from '../../i18n/ui';

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;

// The CV is written once, in English; the Spanish route adds a short note.
const cvLang: Lang = 'en';
const aiProjects = labProjects.slice(0, 4);

const copy = {
  en: {
    title: 'CV',
    description: 'Curriculum vitae of Carlos Rendón: Salesforce & AI solutions engineer, Brisbane.',
    note: '',
    print: 'Print or save as PDF',
  },
  es: {
    title: 'CV',
    description: 'Hoja de vida de Carlos Rendón: ingeniero de soluciones Salesforce e IA, Brisbane.',
    note: 'Mi hoja de vida está en inglés, el idioma de la mayoría de los procesos en los que participo. Si la necesitas en español, escríbeme.',
    print: 'Imprimir o guardar como PDF',
  },
}[lang];
---

<Base lang={lang} page="cv" title={copy.title} description={copy.description}>
  <section class="cv">
    <div class="wrap"><div class="prose cv-body" lang={lang === 'es' ? 'en' : undefined}>
      {copy.note && <p class="callout no-print" lang="es">{copy.note}</p>}
      <div class="btn-row no-print">
        <button class="btn btn-ghost" type="button" onclick="window.print()">{copy.print}</button>
      </div>

      <h1>Carlos Rendón</h1>
      <p class="headline">Salesforce & AI Solutions Engineer · OmniStudio · Enterprise integration · Applied AI: MCP, RAG, AI agents with human oversight</p>
      <p class="machine">
        Brisbane, QLD · {SITE.email} · linkedin.com/in/carlosrendonduque · carlosrendon.co<br />
        Australian and Colombian citizen · Security cleared · Remote or hybrid · Available now
      </p>

      <h2>Summary</h2>
      <p>
        Salesforce and AI solutions engineer with twenty years in software development. I start from the business problem, then design, build and
        integrate the solution, choosing between declarative tools and code: OmniScripts, FlexCards, Integration Procedures, Lightning Web Components,
        Flows and Apex. Recent engagements include a national health service’s a national counselling line national counselling platform, a state police service online reporting and
        a government services contractor. I apply the same approach to AI through independent projects: an MCP server with a RAG pipeline in daily use, a human-in-the-loop
        control layer for AI agents and a multi-model writing editor, following freelance LLM evaluation work.
      </p>

      <h2>Selected engagements</h2>
      {
        cases.map((c) => (
          <div class="cv-item">
            <h3>{c.client[cvLang]} · {c.period}</h3>
            <p class="machine">{c.role[cvLang]} · {c.stack.join(' · ')}</p>
            <ul>{c.points[cvLang].map((p) => <li>{p}</li>)}</ul>
          </div>
        ))
      }

      <h2>Experience</h2>
      <ul class="cv-exp">
        {experience.map((e) => <li><span class="machine">{e.when}</span> <strong>{e.role[cvLang]}</strong>, {e.where}</li>)}
      </ul>

      <h2>Independent AI projects</h2>
      {
        aiProjects.map((p) => (
          <div class="cv-item">
            <h3>{p.name}: {p.tagline[cvLang]}</h3>
            <p class="machine">{p.stack.join(' · ')} · {p.status[cvLang]}</p>
            <ul>{p.points[cvLang].map((pt) => <li>{pt}</li>)}</ul>
          </div>
        ))
      }

      <h2>Certifications</h2>
      <ul>
        {certifications.map((c) => <li>{c} (2022)</li>)}
        <li>PCEP, Certified Entry-Level Python Programmer, Python Institute (2020)</li>
        <li>Scrum Master, International Scrum Institute (2018)</li>
      </ul>

      <h2>Education</h2>
      <ul>
        <li>Master of Literary Creation and Digital Narratives, Universidad Icesi, Cali (in progress)</li>
        <li>Bachelor of Psychology (human-computer interaction), Corporación Universitaria UNITEC (2020 – 2024)</li>
        <li>Master’s Degree, Digital Business & Lean Startup, IEBS (2020 – 2022)</li>
        <li>Bachelor of Systems Engineering, Universidad de Antioquia, Medellín (1995 – 2002)</li>
      </ul>

      <h2>Languages</h2>
      <p>English (full professional) · Spanish (native)</p>
      <p class="machine">References available on request.</p>
    </div>
    </div>
  </section>
</Base>

<style>
  .cv-body h2 {
    font-size: 1.5rem;
    margin-top: 2.2rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--line);
  }
  .cv-body h3 {
    font-size: 1.1rem;
    margin: 1.2rem 0 0.2rem;
  }
  .headline {
    font-size: 1.1rem;
  }
  .cv-exp {
    list-style: none;
    padding: 0;
  }
  .cv-exp .machine {
    display: inline-block;
    min-width: 7.5rem;
  }
  button.btn {
    cursor: pointer;
    background: transparent;
    color: var(--ink);
  }
  @media print {
    .cv-body {
      max-width: none;
      width: 100%;
    }
    .cv-body h2 {
      font-size: 13pt;
      margin-top: 12pt;
    }
    .cv-item {
      break-inside: avoid;
    }
  }
</style>
