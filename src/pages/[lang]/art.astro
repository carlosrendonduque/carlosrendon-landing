---
import Base from '../../layouts/Base.astro';
import { artworks } from '../../data/content';
import ChatButton from '../../components/ChatButton.astro';
import { ui, staticLangPaths, type Lang } from '../../i18n/ui';

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;
const t = ui[lang];

const copy = {
  en: {
    title: 'Art',
    description: 'Transmedia fiction, interactive stories and AI-assisted music by Carlos Rendón.',
    eyebrow: 'Collaborate on art',
    h1: 'Stories where the interface is the narrator',
    lede: 'Fiction across print, web and sound. And music. AI appears twice: as a character, and as a tool that never gets the final word.',
    worksTitle: 'Works',
    open: 'Open',
    musicTitle: 'Music',
    music: 'I produce in Ableton with AI in the chain: generated sketches and synthetic voices as raw material, finished by hand. My project is Koombia Mate: cumbia, reggaeton, electronica and punk. Releases coming soon.',
    statementTitle: 'On AI and authorship',
    statement: 'Models propose; I choose, rewrite and sign. When a piece uses generated material, I say so.',
    collabTitle: 'Let’s make something',
    collab: 'Illustrators, book artists, musicians, vocalists, narrative game studios, festivals and universities.',
    collabCta: 'Propose a collaboration',
    collabSubject: 'Collaboration',
  },
  es: {
    title: 'Arte',
    description: 'Ficción transmedia, historias interactivas y música con IA de Carlos Rendón.',
    eyebrow: 'Colaborar en arte',
    h1: 'Historias donde la interfaz es la narradora',
    lede: 'Ficción repartida entre papel, web y sonido. Y música. La IA aparece dos veces: como personaje, y como herramienta que nunca tiene la última palabra.',
    worksTitle: 'Obras',
    open: 'Abrir',
    musicTitle: 'Música',
    music: 'Produzco en Ableton con IA en la cadena: bocetos generados y voces sintéticas como materia prima, terminados a mano. Mi proyecto es Koombia Mate: cumbia, reguetón, electrónica y punk. Los lanzamientos vienen pronto.',
    statementTitle: 'Sobre IA y autoría',
    statement: 'Los modelos proponen; yo elijo, reescribo y firmo. Cuando una pieza usa material generado, lo digo.',
    collabTitle: 'Hagamos algo',
    collab: 'Ilustradores, artistas del libro, músicos, vocalistas, estudios de juegos narrativos, festivales y universidades.',
    collabCta: 'Proponer una colaboración',
    collabSubject: 'Colaboración',
  },
}[lang];
---

<Base lang={lang} page="art" title={copy.title} description={copy.description}>
  <section>
    <div class="wrap">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h1 class="measure">{copy.h1}</h1>
      <p class="lede">{copy.lede}</p>
    </div>
  </section>

  <section aria-labelledby="works-title">
    <div class="wrap">
      <h2 id="works-title">{copy.worksTitle}</h2>
      <div class="grid">
        {
          artworks.map((w) => (
            <article class="card" id={w.id}>
              <span class="status">{w.kind[lang]}</span>
              <h3>{w.name}</h3>
              <p>{w.body[lang]}</p>
              <div class="card-foot">
                {w.live ? (
                  <a class="card-link" href={w.live}>
                    {copy.open}
                    <span class="visually-hidden">: {w.name}</span>
                  </a>
                ) : (
                  <span class="machine">{w.status?.[lang] ?? t.inDevelopment}</span>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="music">
    <div class="wrap two-col">
      <div>
        <h2>{copy.musicTitle}</h2>
        <p>{copy.music}</p>
      </div>
      <div>
        <h2>{copy.statementTitle}</h2>
        <p>{copy.statement}</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="collab-title">
    <div class="wrap">
      <div class="callout measure">
        <h2 id="collab-title">{copy.collabTitle}</h2>
        <p>{copy.collab}</p>
        <ChatButton label={copy.collabCta} subject={copy.collabSubject} />
      </div>
    </div>
  </section>
</Base>

<style>
  .two-col {
    display: grid;
    gap: 2rem 4rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
</style>
