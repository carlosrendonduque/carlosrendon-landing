---
import Base from '../../layouts/Base.astro';
import { artworks } from '../../data/content';
import ChatButton from '../../components/ChatButton.astro';
import { ui, path, staticLangPaths, type Lang } from '../../i18n/ui';

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;
const t = ui[lang];

const copy = {
  en: {
    title: 'Art',
    description: 'Transmedia fiction, interactive stories and AI-assisted music by Carlos Rendón.',
    eyebrow: 'Collaborate on art',
    h1: 'Stories where how you read them is part of what they say',
    lede: 'Fiction across print, web and sound. And music. AI appears twice: as a character, and as a tool that never gets the final word.',
    worksTitle: 'Works',
    open: 'Open',
    musicTitle: 'Music',
    music: 'I built the studio before the songs: a chain where AI proposes at every stage and nothing moves on until I approve it. What a model generates comes in as raw material, never as the result. The project is Koombia Mate: cumbia, reggaeton, electronica and punk.',
    musicTool: 'The tool is in the lab',
    statementTitle: 'On AI and authorship',
    statement: 'Models propose; I choose, rewrite and sign. When a piece uses generated material, I say so.',
    collabTitle: 'Let’s make something',
    collab: 'Book artists, vocalists and sound artists; transmedia producers, narrative game studios and other artists working with AI; and the media labs, festivals and research groups that commission this kind of work.',
    collabCta: 'Propose a collaboration',
    collabSubject: 'Collaboration',
  },
  es: {
    title: 'Arte',
    description: 'Ficción transmedia, historias interactivas y música con IA de Carlos Rendón.',
    eyebrow: 'Colaborar en arte',
    h1: 'Historias donde la forma de leerlas es parte de lo que dicen',
    lede: 'Ficción repartida entre papel, web y sonido. Y música. La IA aparece dos veces: como personaje, y como herramienta que nunca tiene la última palabra.',
    worksTitle: 'Obras',
    open: 'Abrir',
    musicTitle: 'Música',
    music: 'Construí el estudio antes que las canciones: una cadena donde la IA propone en cada etapa y nada avanza sin que yo lo apruebe. Lo que genera un modelo entra como materia prima, nunca como resultado. El proyecto es Koombia Mate: cumbia, reguetón, electrónica y punk.',
    musicTool: 'La herramienta está en el laboratorio',
    statementTitle: 'Sobre IA y autoría',
    statement: 'Los modelos proponen; yo elijo, reescribo y firmo. Cuando una pieza usa material generado, lo digo.',
    collabTitle: 'Hagamos algo',
    collab: 'Artistas del libro, vocalistas y artistas sonoros; productores transmedia, estudios de juegos narrativos y otros artistas que trabajan con IA; y los laboratorios de medios, festivales y grupos de investigación que comisionan este tipo de obra.',
    collabCta: 'Proponer una colaboración',
    collabSubject: 'Colaboración',
  },
}[lang];
---

<Base lang={lang} page="art" title={copy.title} description={copy.description}>
  <section>
    <div class="wrap">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h1 class="measure">{copy.h1}</h1>
      <p class="lede">{copy.lede}</p>
    </div>
  </section>

  <section aria-labelledby="works-title">
    <div class="wrap">
      <h2 id="works-title">{copy.worksTitle}</h2>
      <div class="grid">
        {
          artworks.map((w) => (
            <article class="card" id={w.id}>
              <span class="status">{w.kind[lang]}</span>
              <h3>{w.name}</h3>
              <p>{w.body[lang]}</p>
              <div class="card-foot">
                {w.live ? (
                  <a class="card-link" href={w.live} target="_blank" rel="noopener">
                    {copy.open}
                    <span class="visually-hidden">: {w.name}</span>
                  </a>
                ) : (
                  <span class="machine">{w.status?.[lang] ?? t.inDevelopment}</span>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="music">
    <div class="wrap two-col">
      <div>
        <h2>{copy.musicTitle}</h2>
        <p>{copy.music}</p>
        <p><a class="card-link" href={`${path(lang, 'lab')}#koombia-mcp`}>{copy.musicTool}</a></p>
      </div>
      <div>
        <h2>{copy.statementTitle}</h2>
        <p>{copy.statement}</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="collab-title">
    <div class="wrap">
      <div class="callout measure">
        <h2 id="collab-title">{copy.collabTitle}</h2>
        <p>{copy.collab}</p>
        <ChatButton label={copy.collabCta} subject={copy.collabSubject} />
      </div>
    </div>
  </section>
</Base>

<style>
  .two-col {
    display: grid;
    gap: 2rem 4rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
</style>
