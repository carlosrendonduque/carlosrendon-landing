---
import Base from '../../layouts/Base.astro';
import { SITE, mailto } from '../../site';
import { staticLangPaths, type Lang } from '../../i18n/ui';

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;

const copy = {
  en: {
    title: 'Contact',
    description: 'Get in touch with Carlos Rendón about a role, consulting, an art collaboration or anything else.',
    h1: 'What brings you here?',
    lede: 'Pick the closest option. Each one opens an email with the right subject and a few questions, so I can answer properly. I reply within two working days.',
    how: 'How did you find me?',
    options: [
      {
        id: 'role',
        title: 'A role',
        body: 'Contract or permanent: Salesforce, OmniStudio or applied AI.',
        subject: 'Role enquiry',
        questions: ['Role and company:', 'Contract or permanent, and day rate or salary range:', 'Start date and location (remote, hybrid, Brisbane):'],
      },
      {
        id: 'consulting',
        title: 'Consulting',
        body: 'Unoffice hours, a readiness review, or help building something.',
        subject: 'Consulting enquiry',
        questions: ['Your team and what you’re trying to do:', 'Timeline:', 'Budget range (if known):'],
      },
      {
        id: 'art',
        title: 'Art collaboration',
        body: 'Writing, music, interactive work, festivals and residencies.',
        subject: 'Art collaboration',
        questions: ['Who you are and what you make:', 'The idea:', 'Dates or deadlines:'],
      },
      {
        id: 'other',
        title: 'Something else',
        body: 'Questions, talks, podcasts, or just saying hello.',
        subject: 'Hello',
        questions: ['Message:'],
      },
    ],
    direct: 'Or write directly',
  },
  es: {
    title: 'Contacto',
    description: 'Escríbele a Carlos Rendón sobre un rol, consultoría, una colaboración artística o cualquier otra cosa.',
    h1: '¿Qué te trae por aquí?',
    lede: 'Elige la opción más cercana. Cada una abre un correo con el asunto correcto y unas preguntas, para poder responderte bien. Respondo en dos días hábiles.',
    how: '¿Cómo me encontraste?',
    options: [
      {
        id: 'role',
        title: 'Un rol',
        body: 'Contrato o planta: Salesforce, OmniStudio o IA aplicada.',
        subject: 'Consulta por un rol',
        questions: ['Rol y empresa:', 'Contrato o planta, y tarifa diaria o rango salarial:', 'Fecha de inicio y modalidad (remoto, híbrido, Brisbane):'],
      },
      {
        id: 'consulting',
        title: 'Consultoría',
        body: 'Unoffice hours, un diagnóstico o ayuda para construir algo.',
        subject: 'Consulta de consultoría',
        questions: ['Tu equipo y lo que quieres lograr:', 'Plazos:', 'Rango de presupuesto (si lo sabes):'],
      },
      {
        id: 'art',
        title: 'Colaboración artística',
        body: 'Escritura, música, obra interactiva, festivales y residencias.',
        subject: 'Colaboración artística',
        questions: ['Quién eres y qué haces:', 'La idea:', 'Fechas o plazos:'],
      },
      {
        id: 'other',
        title: 'Otra cosa',
        body: 'Preguntas, charlas, podcasts o simplemente saludar.',
        subject: 'Hola',
        questions: ['Mensaje:'],
      },
    ],
    direct: 'O escribe directamente',
  },
}[lang];

const bodyFor = (questions: readonly string[]) => [...questions, copy.how].map((q) => `${q}\n\n`).join('');
---

<Base lang={lang} page="contact" title={copy.title} description={copy.description}>
  <section>
    <div class="wrap">
      <h1>{copy.h1}</h1>
      <p class="lede">{copy.lede}</p>
      <div class="grid options">
        {
          copy.options.map((o) => (
            <a class="card option" id={o.id} href={mailto(o.subject, bodyFor(o.questions))}>
              <h2 class="option-title">{o.title}</h2>
              <p>{o.body}</p>
              <span class="card-link" aria-hidden="true">
                {lang === 'en' ? 'Write' : 'Escribir'}
              </span>
            </a>
          ))
        }
      </div>
      <p class="direct">
        {copy.direct}: <a href={`mailto:${SITE.email}`}>{SITE.email}</a> · <a href={SITE.linkedin}>LinkedIn</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .option {
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .option:hover {
    border-color: var(--accent);
  }
  .option-title {
    font-size: 1.4rem;
    margin: 0;
  }
  .direct {
    margin-top: 2rem;
    color: var(--muted);
  }
</style>
