---
import Base from '../../layouts/Base.astro';
import ChatButton from '../../components/ChatButton.astro';
import { cases, scopes, certifications } from '../../data/content';
import { SITE } from '../../site';
import { staticLangPaths, type Lang } from '../../i18n/ui';

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;

const copy = {
  en: {
    title: 'Salesforce & OmniStudio work',
    description: 'Salesforce and OmniStudio engineering for the health and public sectors and insurance.',
    eyebrow: 'Hire me',
    h1: 'Salesforce for services people depend on',
    lede: 'Health, public sector and insurance platforms: from unclear requirements to production, and what comes after release.',
    looking: 'Open to Salesforce, OmniStudio and applied-AI contracts, remote or Brisbane.',
    ctaPrimary: 'Talk about a role',
    ctaSubject: 'Role enquiry',
    casesTitle: 'Selected work',
    scopesTitle: 'What I work on',
    certTitle: 'Salesforce certifications',
    note: 'Australian and Colombian citizen · security cleared · English and Spanish',
  },
  es: {
    title: 'Trabajo en Salesforce y OmniStudio',
    description: 'Ingeniería en Salesforce y OmniStudio para los sectores salud, público y seguros.',
    eyebrow: 'Contratarme',
    h1: 'Salesforce para servicios de los que la gente depende',
    lede: 'Plataformas de salud, sector público y seguros: desde requerimientos poco claros hasta producción, y lo que viene después del release.',
    looking: 'Abierto a contratos de Salesforce, OmniStudio e IA aplicada, remoto o en Brisbane.',
    ctaPrimary: 'Hablemos de un rol',
    ctaSubject: 'Consulta sobre un rol',
    casesTitle: 'Trabajo destacado',
    scopesTitle: 'En qué trabajo',
    certTitle: 'Certificaciones Salesforce',
    note: 'Ciudadano australiano y colombiano · habilitación de seguridad · español e inglés',
  },
}[lang];
---

<Base lang={lang} page="work" title={copy.title} description={copy.description}>
  <section>
    <div class="wrap">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h1 class="measure">{copy.h1}</h1>
      <p class="lede">{copy.lede}</p>
      <p class="eligibility">{copy.note}</p>
      <p class="machine">{copy.looking}</p>
      <div class="btn-row">
        <ChatButton label={copy.ctaPrimary} subject={copy.ctaSubject} />
        <a class="btn btn-ghost" href={SITE.linkedin}>LinkedIn</a>
      </div>
    </div>
  </section>

  <section aria-labelledby="cases-title">
    <div class="wrap">
      <h2 id="cases-title">{copy.casesTitle}</h2>
      <div class="grid">
        {
          cases.map((c) => (
            <article class="card" id={c.id}>
              <span class="status">{c.sector[lang]}</span>
              <h3>{c.title[lang]}</h3>
              <ul class="points">
                {c.points[lang].map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
              <ul class="tags card-foot">
                {c.capabilities[lang].map((cap) => (
                  <li>{cap}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section aria-labelledby="scopes-title">
    <div class="wrap two-col">
      <div>
        <h2 id="scopes-title">{copy.scopesTitle}</h2>
        <ul class="scopes">{scopes.map((s) => <li>{s[lang]}</li>)}</ul>
      </div>
      <div>
        <h2>{copy.certTitle}</h2>
        <ul class="tags certs">{certifications.map((c) => <li>{c}</li>)}</ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .points {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--muted);
  }
  .points li {
    margin-bottom: 0.35rem;
  }
  .two-col {
    display: grid;
    gap: 2rem 4rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  /* No rail and no emphasised last item: these are areas of work, not steps,
     and nothing here is further along than anything else. */
  .scopes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.7rem;
  }
  .scopes li {
    position: relative;
    padding-left: 1.1rem;
  }
  .scopes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .certs li {
    font-size: 0.8rem;
  }
  .eligibility {
    display: inline-block;
    font-weight: 600;
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: 0.6rem 0.9rem;
    margin: 0.25rem 0 1rem;
  }
</style>
