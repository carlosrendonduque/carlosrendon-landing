---
import Base from '../../layouts/Base.astro';
import ChatButton from '../../components/ChatButton.astro';
import { cases, path as career, certifications } from '../../data/content';
import { SITE } from '../../site';
import { staticLangPaths, type Lang } from '../../i18n/ui';

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;

const copy = {
  en: {
    title: 'Work',
    description: 'Salesforce and OmniStudio engineering for the health and public sectors and insurance.',
    eyebrow: 'Hire me',
    h1: 'Salesforce where mistakes reach real people',
    lede: 'Health, public sector and insurance platforms: from unclear requirements to production, and what comes after release.',
    looking: 'Open to Salesforce, OmniStudio and applied-AI roles. Contract or permanent, remote or Brisbane.',
    ctaPrimary: 'Talk about a role',
    casesTitle: 'Selected work',
    pathTitle: 'The path so far',
    certTitle: 'Salesforce certifications',
    note: 'Australian and Colombian citizen · security cleared · English and Spanish',
  },
  es: {
    title: 'Trabajo',
    description: 'Ingeniería Salesforce y OmniStudio para los sectores salud, público y seguros.',
    eyebrow: 'Contratarme',
    h1: 'Salesforce donde los errores le llegan a personas reales',
    lede: 'Plataformas de salud, sector público y seguros: desde requerimientos poco claros hasta producción, y lo que viene después del release.',
    looking: 'Abierto a roles de Salesforce, OmniStudio e IA aplicada. Contrato o planta, remoto o en Brisbane.',
    ctaPrimary: 'Hablemos de un rol',
    casesTitle: 'Trabajo seleccionado',
    pathTitle: 'El recorrido',
    certTitle: 'Certificaciones Salesforce',
    note: 'Ciudadano australiano y colombiano · habilitación de seguridad · español e inglés',
  },
}[lang];
---

<Base lang={lang} page="work" title={copy.title} description={copy.description}>
  <section>
    <div class="wrap">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h1 class="measure">{copy.h1}</h1>
      <p class="lede">{copy.lede}</p>
      <p class="machine">{copy.looking}</p>
      <div class="btn-row">
        <ChatButton label={copy.ctaPrimary} />
        <a class="btn btn-ghost" href={SITE.linkedin}>LinkedIn</a>
      </div>
    </div>
  </section>

  <section aria-labelledby="cases-title">
    <div class="wrap">
      <h2 id="cases-title">{copy.casesTitle}</h2>
      <div class="grid">
        {
          cases.map((c) => (
            <article class="card" id={c.id}>
              <span class="status">{c.sector[lang]}</span>
              <h3>{c.title[lang]}</h3>
              <ul class="points">
                {c.points[lang].map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
              <ul class="tags card-foot">
                {c.stack.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section aria-labelledby="path-title">
    <div class="wrap two-col">
      <div>
        <h2 id="path-title">{copy.pathTitle}</h2>
        <ol class="career">{career.map((step) => <li>{step[lang]}</li>)}</ol>
      </div>
      <div>
        <h2>{copy.certTitle}</h2>
        <ul class="tags certs">{certifications.map((c) => <li>{c}</li>)}</ul>
        <p class="machine note">{copy.note}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .points {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--muted);
  }
  .points li {
    margin-bottom: 0.35rem;
  }
  .two-col {
    display: grid;
    gap: 2rem 4rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .career {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 2px solid var(--line);
  }
  .career li {
    position: relative;
    padding: 0 0 1.1rem 1.25rem;
  }
  .career li::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 0.55em;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--muted);
  }
  .career li:last-child::before {
    background: var(--accent);
    border-color: var(--accent);
  }
  .certs li {
    font-size: 0.8rem;
  }
  .note {
    margin-top: 1.5rem;
  }
</style>
