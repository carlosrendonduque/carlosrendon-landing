---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { labProjects } from '../../data/content';
import { SITE } from '../../site';
import { staticLangPaths, type Lang } from '../../i18n/ui';

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;

const ai = labProjects.filter((p) => p.kind === 'ai');
const foundations = labProjects.filter((p) => p.kind === 'foundations');
const story = labProjects.filter((p) => p.kind === 'story');

const copy = {
  en: {
    title: 'Lab',
    description: 'Applied-AI tools and open-source projects by Carlos Rendón.',
    eyebrow: 'Lab',
    h1: 'Tools I build and use',
    lede: 'Built on existing models, not ones I trained. Same rule everywhere: a person defines what runs on its own and what waits for approval.',
    aiTitle: 'Applied AI',
    foundationsTitle: 'Evals and foundations',
    foundationsLede: 'Where I measure agents and learn the layers underneath: tokenizers, sampling and, next, training.',
    storyTitle: 'For storytelling',
    github: 'More on GitHub',
  },
  es: {
    title: 'Laboratorio',
    description: 'Herramientas de IA aplicada y proyectos de código abierto de Carlos Rendón.',
    eyebrow: 'Laboratorio',
    h1: 'Herramientas que construyo y uso',
    lede: 'Sobre modelos existentes, no entrenados por mí. La misma regla en todas: una persona define qué corre solo y qué espera aprobación.',
    aiTitle: 'IA aplicada',
    foundationsTitle: 'Evaluación y fundamentos',
    foundationsLede: 'Donde mido agentes y aprendo las capas de abajo: tokenizadores, muestreo y, después, entrenamiento.',
    storyTitle: 'Para narrar',
    github: 'Más en GitHub',
  },
}[lang];
---

<Base lang={lang} page="lab" title={copy.title} description={copy.description}>
  <section>
    <div class="wrap">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h1>{copy.h1}</h1>
      <p class="lede">{copy.lede}</p>
    </div>
  </section>

  <section aria-labelledby="ai-title">
    <div class="wrap">
      <h2 id="ai-title">{copy.aiTitle}</h2>
      <div class="grid">{ai.map((p) => <ProjectCard project={p} lang={lang} />)}</div>
    </div>
  </section>

  <section aria-labelledby="foundations-title">
    <div class="wrap">
      <h2 id="foundations-title">{copy.foundationsTitle}</h2>
      <p>{copy.foundationsLede}</p>
      <div class="grid">{foundations.map((p) => <ProjectCard project={p} lang={lang} />)}</div>
    </div>
  </section>

  <section aria-labelledby="story-title">
    <div class="wrap">
      <h2 id="story-title">{copy.storyTitle}</h2>
      <div class="grid">{story.map((p) => <ProjectCard project={p} lang={lang} />)}</div>
      <div class="btn-row"><a class="btn btn-ghost" href={SITE.github} target="_blank" rel="noopener">{copy.github}</a></div>
    </div>
  </section>
</Base>
