---
import Base from '../../layouts/Base.astro';
import ChatButton from '../../components/ChatButton.astro';
import { SITE } from '../../site';
import { path, staticLangPaths, type Lang } from '../../i18n/ui';
import { personJsonLd } from '../../data/person';

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;

const copy = {
  en: {
    title: 'About',
    description: 'Carlos Rendón: applied-AI engineer and writer of transmedia fiction, from Medellín, based in Brisbane.',
    h1: '“We are human, after all”',
    h1Credit: 'Daft Punk',
    photoAlt: 'Carlos Rendón in his home studio with headphones and a guitar.',
    story: [
      'I’m from Medellín and I now live in Brisbane. I build AI tools that I use every day.',
      'After studying systems engineering and a long run building software across a lot of sectors, I gave myself room to widen the borders a bit. I have always been a curious person, so I studied psychology, the part about how people use computers, and now I am doing a Master’s in literary creation and digital narratives. It can look chaotic and scattered, and deep down I do not think it is: the ideas that pull at me hardest come from where technology, the human factor and creativity meet.',
      'The interaction between people and AI has me thinking every day. Authorship: what we make today alongside an AI, whose is it? The author’s? The AI’s? The millions of works, songs and books by artists it was trained on? The entertainment giants’? Who decides — the AI, or the person? And ethics: what can we allow ourselves? An AI that treats patients? That gives us advice, that is our friend? How far do we let it decide for us?',
      'All of those questions come out of my daily work, and my conclusion is always the same: the human, with all their leaks and flaws and failures, should be the one out front. For how long, I do not know. But at least in my case that is what I believe and how I try to build my tools — human judgement in front and in command, even when it gets things wrong. Never the other way round, never AI commanding us. And if we get it wrong, so what? We are human, after all.',
      'So this is where I will be: playing, enjoying myself and exploring these emerging technologies while it all evolves in a world moving this fast, and seeing what is waiting for us, apocalypse or utopia. I hope some of what I make turns out to be useful to someone at work, or at least fun.',
    ],
    eduTitle: 'Study',
    edu: [
      'Master’s in Literary Creation and Digital Narratives, Universidad Icesi (in progress)',
      'Psychology, human-computer interaction',
      'Master’s in Digital Business & Lean Startup, IEBS',
      'Systems Engineering, Universidad de Antioquia',
    ],
    cta: 'Get in touch',
    ctaSubject: 'Hello',
  },
  es: {
    title: 'Sobre mí',
    description: 'Carlos Rendón: ingeniero de IA aplicada y escritor de ficción transmedia, de Medellín, radicado en Brisbane.',
    h1: '“Al fin de cuentas somos humanos”',
    h1Credit: 'Daft Punk',
    photoAlt: 'Carlos Rendón en su estudio casero con audífonos y una guitarra.',
    story: [
      'Soy de Medellín y ahora vivo en Brisbane. Construyo herramientas de IA que uso todos los días.',
      'Después de estudiar Ingeniería de Sistemas y de una larga trayectoria en software para distintos sectores, me di la oportunidad de ampliar un poco mis fronteras. Siempre he sido una persona muy curiosa, por lo que estudié psicología, con énfasis en cómo las personas usan los computadores, y ahora hago una maestría en creación literaria y narrativas digitales. Aunque puede verse un poco caótico y disperso, en el fondo siento que no lo es: creo que la confluencia de tecnología, factor humano y creatividad es donde surgen las ideas que más me atraen.',
      'La interacción entre humanos e IA me hace reflexionar todos los días. La autoría: lo que hacemos hoy en colaboración con una IA, ¿de quién es? ¿Del autor? ¿De la IA? ¿De los millones de obras, canciones y libros de artistas con los que se entrenó? ¿De los gigantes del entretenimiento? Quién decide: ¿la IA?, ¿el humano? Y la ética: ¿qué nos podemos permitir? ¿Una IA que atienda pacientes? ¿Que nos dé consejos, que sea nuestra amiga? ¿Hasta dónde dejamos que decida por nosotros?',
      'Todas esas preguntas salen de mi trabajo diario, y mi conclusión siempre es la misma: el humano, con todas sus goteras, imperfecciones y fallos, debe ser quien esté al frente. Por cuánto tiempo, no lo sé. Pero por lo menos en mi caso es en lo que creo y es como procuro construir mis herramientas: el criterio humano adelante y su juicio al mando, así se equivoque. Nunca al revés, nunca que la IA nos comande a nosotros. ¿Y si nos equivocamos, qué? Al fin de cuentas somos humanos, ¿no?',
      'Así que por aquí seguiré: jugando, divirtiéndome y explorando estas tecnologías emergentes mientras todo evoluciona en este mundo vertiginoso, y viendo qué nos espera, si el apocalipsis o la utopía. Ojalá alguna de estas cosas que hago le sirva a alguien en su trabajo, o que al menos le parezcan divertidas.',
    ],
    eduTitle: 'Estudios',
    edu: [
      'Maestría en Creación Literaria y Narrativas Digitales, Universidad Icesi (en curso)',
      'Psicología, interacción humano-computador',
      'Máster en Negocio Digital y Lean Startup, IEBS',
      'Ingeniería de Sistemas, Universidad de Antioquia',
    ],
    cta: 'Hablemos',
    ctaSubject: 'Hola',
  },
}[lang];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: new URL(path(lang, 'about'), SITE.url).href,
  dateModified: SITE.updated,
  mainEntity: personJsonLd(lang),
};
---

<Base lang={lang} page="about" title={copy.title} description={copy.description} jsonLd={jsonLd}>
  <section>
    <div class="wrap about-grid">
      <div class="prose">
        <h1>{copy.h1}</h1>
        <p class="h1-credit">{copy.h1Credit}</p>
        {copy.story.map((p) => <p>{p}</p>)}
        <h2 class="edu-title">{copy.eduTitle}</h2>
        <ul>{copy.edu.map((e) => <li>{e}</li>)}</ul>
        <div class="btn-row"><ChatButton label={copy.cta} subject={copy.ctaSubject} /></div>
      </div>
      <picture>
        <source srcset="/images/carlos.webp" type="image/webp" />
        <img src="/images/carlos.jpg" alt={copy.photoAlt} width="1200" height="1407" loading="lazy" class="about-photo" />
      </picture>
    </div>
  </section>
</Base>

<style>
  .about-grid {
    display: grid;
    gap: 3rem;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: start;
  }
  @media (max-width: 820px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
  .about-photo {
    border-radius: 14px;
  }
  /* The heading is a borrowed line, so it is quoted and attributed. */
  .h1-credit {
    font-family: var(--font-machine);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--faint);
    margin: -0.7rem 0 1.7rem;
  }
  .edu-title {
    font-size: 1.4rem;
    margin-top: 2rem;
  }
</style>
