---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site';
import { path, staticLangPaths, type Lang } from '../../i18n/ui';
import { personJsonLd } from '../../data/person';

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;

const copy = {
  en: {
    title: 'About',
    description: 'Carlos Rendón: engineer, writer and music producer from Medellín, based in Brisbane.',
    h1: 'Between systems and people',
    photoAlt: 'Carlos Rendón in his home studio with headphones and a guitar.',
    story: [
      'I’m from Medellín and live in Brisbane. I started on payroll systems, co-founded a software consultancy, and now build Salesforce platforms for the health and public sectors.',
      'I also studied psychology, focused on how people use computers, and I’m doing a Master’s in Literary Creation and Digital Narratives. The same question runs through all of it: who decides, the person or the machine?',
      'So I build AI tools, write fiction and make music, with one rule: AI proposes, the human decides.',
    ],
    eduTitle: 'Study',
    edu: [
      'Master’s in Literary Creation and Digital Narratives, Universidad Icesi (in progress)',
      'Psychology, human-computer interaction',
      'Master’s in Digital Business & Lean Startup, IEBS',
      'Systems Engineering, Universidad de Antioquia',
    ],
    cta: 'Get in touch',
  },
  es: {
    title: 'Sobre mí',
    description: 'Carlos Rendón: ingeniero, escritor y productor musical de Medellín, radicado en Brisbane.',
    h1: 'Entre sistemas y personas',
    photoAlt: 'Carlos Rendón en su estudio casero con audífonos y una guitarra.',
    story: [
      'Soy de Medellín y vivo en Brisbane. Empecé en sistemas de nómina, cofundé una consultora de software y hoy construyo plataformas Salesforce para los sectores salud y público.',
      'También estudié psicología, con énfasis en cómo las personas usan los computadores, y hago una Maestría en Creación Literaria y Narrativas Digitales. La misma pregunta atraviesa todo: ¿quién decide, la persona o la máquina?',
      'Por eso construyo herramientas de IA, escribo ficción y hago música, con una regla: la IA propone, el humano decide.',
    ],
    eduTitle: 'Estudios',
    edu: [
      'Maestría en Creación Literaria y Narrativas Digitales, Universidad Icesi (en curso)',
      'Psicología, interacción humano-computador',
      'Máster en Negocio Digital y Lean Startup, IEBS',
      'Ingeniería de Sistemas, Universidad de Antioquia',
    ],
    cta: 'Hablemos',
  },
}[lang];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: new URL(path(lang, 'about'), SITE.url).href,
  dateModified: SITE.updated,
  mainEntity: personJsonLd(lang),
};
---

<Base lang={lang} page="about" title={copy.title} description={copy.description} jsonLd={jsonLd}>
  <section>
    <div class="wrap about-grid">
      <div class="prose">
        <h1>{copy.h1}</h1>
        {copy.story.map((p) => <p>{p}</p>)}
        <h2 class="edu-title">{copy.eduTitle}</h2>
        <ul>{copy.edu.map((e) => <li>{e}</li>)}</ul>
        <div class="btn-row"><a class="btn btn-primary" href={path(lang, 'contact')}>{copy.cta}</a></div>
      </div>
      <picture>
        <source srcset="/images/carlos.webp" type="image/webp" />
        <img src="/images/carlos.jpg" alt={copy.photoAlt} width="1000" height="1173" loading="lazy" class="about-photo" />
      </picture>
    </div>
  </section>
</Base>

<style>
  .about-grid {
    display: grid;
    gap: 3rem;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: start;
  }
  @media (max-width: 820px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
  .about-photo {
    border-radius: 14px;
  }
  .edu-title {
    font-size: 1.4rem;
    margin-top: 2rem;
  }
</style>
