---
import Base from '../../layouts/Base.astro';
import ChatButton from '../../components/ChatButton.astro';
import { SITE } from '../../site';
import { path, staticLangPaths, type Lang } from '../../i18n/ui';
import { personJsonLd } from '../../data/person';

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;

const copy = {
  en: {
    title: 'About',
    description: 'Carlos Rendón: applied-AI engineer and writer of transmedia fiction, from Medellín, based in Brisbane.',
    h1: 'Between systems and people',
    photoAlt: 'Carlos Rendón in his home studio with headphones and a guitar.',
    story: [
      'I’m from Medellín and I live in Brisbane. I build AI tools and use them every day: my own MCP server, an editor where the model proposes and I decide.',
      'Before that I worked on large enterprise platforms, the kind where a bad release shows up outside the building. That teaches you what you cannot study — how to put something new into a system that is already running, without knocking it over.',
      'I also studied psychology, the part about how people use computers, and now I am doing a Master’s in literary creation and digital narratives. It sounds scattered and it is not. It is the same question every time: who decides, the person or the machine. So I write fiction and make music by the same rule I code by.',
    ],
    eduTitle: 'Study',
    edu: [
      'Master’s in Literary Creation and Digital Narratives, Universidad Icesi (in progress)',
      'Psychology, human-computer interaction',
      'Master’s in Digital Business & Lean Startup, IEBS',
      'Systems Engineering, Universidad de Antioquia',
    ],
    cta: 'Get in touch',
    ctaSubject: 'Hello',
  },
  es: {
    title: 'Sobre mí',
    description: 'Carlos Rendón: ingeniero de IA aplicada y escritor de ficción transmedia, de Medellín, radicado en Brisbane.',
    h1: 'Entre sistemas y personas',
    photoAlt: 'Carlos Rendón en su estudio casero con audífonos y una guitarra.',
    story: [
      'Soy de Medellín y vivo en Brisbane. Construyo herramientas de IA y las uso todos los días: mi propio servidor MCP, un editor donde el modelo propone y yo decido.',
      'Antes trabajé en plataformas empresariales grandes, de esas donde un despliegue malo se nota afuera. Ahí uno aprende lo que no se estudia: cómo meterle algo nuevo a un sistema que ya está corriendo, sin tumbarlo.',
      'También estudié psicología, mirando cómo la gente usa los computadores, y ahora hago una maestría en creación literaria y narrativas digitales. Suena disperso y no lo es. Siempre es la misma pregunta: quién decide, si la persona o la máquina. Por eso escribo ficción y hago música con la misma regla con la que programo.',
    ],
    eduTitle: 'Estudios',
    edu: [
      'Maestría en Creación Literaria y Narrativas Digitales, Universidad Icesi (en curso)',
      'Psicología, interacción humano-computador',
      'Máster en Negocio Digital y Lean Startup, IEBS',
      'Ingeniería de Sistemas, Universidad de Antioquia',
    ],
    cta: 'Hablemos',
    ctaSubject: 'Hola',
  },
}[lang];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: new URL(path(lang, 'about'), SITE.url).href,
  dateModified: SITE.updated,
  mainEntity: personJsonLd(lang),
};
---

<Base lang={lang} page="about" title={copy.title} description={copy.description} jsonLd={jsonLd}>
  <section>
    <div class="wrap about-grid">
      <div class="prose">
        <h1>{copy.h1}</h1>
        {copy.story.map((p) => <p>{p}</p>)}
        <h2 class="edu-title">{copy.eduTitle}</h2>
        <ul>{copy.edu.map((e) => <li>{e}</li>)}</ul>
        <div class="btn-row"><ChatButton label={copy.cta} subject={copy.ctaSubject} /></div>
      </div>
      <picture>
        <source srcset="/images/carlos.webp" type="image/webp" />
        <img src="/images/carlos.jpg" alt={copy.photoAlt} width="1200" height="1407" loading="lazy" class="about-photo" />
      </picture>
    </div>
  </section>
</Base>

<style>
  .about-grid {
    display: grid;
    gap: 3rem;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: start;
  }
  @media (max-width: 820px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
  .about-photo {
    border-radius: 14px;
  }
  .edu-title {
    font-size: 1.4rem;
    margin-top: 2rem;
  }
</style>
