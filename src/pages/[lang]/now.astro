---
import Base from '../../layouts/Base.astro';
import ChatButton from '../../components/ChatButton.astro';
import { SITE } from '../../site';
import { path, formatDate, staticLangPaths, type Lang } from '../../i18n/ui';

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;

const copy = {
  en: {
    title: 'Now',
    description: 'What Carlos Rendón is working on right now, and his availability.',
    h1: 'Now',
    updated: 'Last updated',
    items: [
      ['Available', 'For Salesforce, OmniStudio and applied-AI work, now. Remote or Brisbane.'],
      ['Building', 'WorkBrain and Bayzara: memory and approval for AI agents.'],
      ['Writing', 'Toma 1024, my Master’s thesis.'],
      ['Producing', 'Songs for Toma 1024 and Koombia Mate.'],
    ],
    note: 'This is a now page, inspired by Derek Sivers’ nownownow.com.',
    cta: 'Get in touch',
  },
  es: {
    title: 'Ahora',
    description: 'En qué está trabajando Carlos Rendón ahora mismo, y su disponibilidad.',
    h1: 'Ahora',
    updated: 'Última actualización',
    items: [
      ['Disponible', 'Para trabajo de Salesforce, OmniStudio e IA aplicada, desde ya. Remoto o en Brisbane.'],
      ['Construyendo', 'WorkBrain y Bayzara: memoria y aprobación para agentes de IA.'],
      ['Escribiendo', 'Toma 1024, mi trabajo de grado.'],
      ['Produciendo', 'Canciones para Toma 1024 y Koombia Mate.'],
    ],
    note: 'Esta es una página "now", inspirada en nownownow.com de Derek Sivers.',
    cta: 'Hablemos',
  },
}[lang];
---

<Base lang={lang} page="now" title={copy.title} description={copy.description}>
  <section>
    <div class="wrap"><div class="prose">
      <h1>{copy.h1}</h1>
      <p class="machine">{copy.updated}: <time datetime={SITE.updated}>{formatDate(SITE.updated, lang)}</time> · Brisbane</p>
      <dl class="now-list">
        {
          copy.items.map(([k, v]) => (
            <>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </>
          ))
        }
      </dl>
      <div class="btn-row"><ChatButton label={copy.cta} /></div>
      <p class="hint">{copy.note}</p>
    </div>
    </div>
  </section>
</Base>

<style>
  .now-list dt {
    font-family: var(--font-human);
    font-size: 1.35rem;
    margin-top: 1.5rem;
  }
  .now-list dd {
    margin: 0.25rem 0 0;
    color: var(--muted);
  }
</style>
