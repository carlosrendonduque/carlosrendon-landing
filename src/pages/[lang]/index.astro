---
import Base from '../../layouts/Base.astro';
import Newsletter from '../../components/Newsletter.astro';
import ChatButton from '../../components/ChatButton.astro';
import { SITE } from '../../site';
import { path, ui, staticLangPaths, type Lang } from '../../i18n/ui';
import { personJsonLd } from '../../data/person';
import { testimonials } from '../../data/testimonials';

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;

const copy = {
  en: {
    title: 'Carlos Rendón — Applied AI engineer: MCP, memory, agents',
    description: 'I put AI inside the process your people already work in, with governance, measurement and someone accountable for every decision. Brisbane or remote.',
    eyebrow: 'Brisbane · remote · English & Spanish',
    h1: 'AI inside your process, not beside it.',
    lede: 'I understand the architecture, the business, and the person who will use it. I build with governance, measurement, and someone accountable for every decision.',
    photoAlt: 'Carlos Rendón smiling at a desk in an open-plan office, hands clasped under his chin.',
    ctaSubject: 'Project enquiry',
    routesTitle: 'What brings you here?',
    routes: [
      { title: 'Bring AI into your team', body: 'I put AI into your processes: what the machine automates, what a person decides, how it is measured. Concretely: MCP, memory and agent orchestration. The first conversation is free.', cta: 'See consulting', href: path('en', 'consulting') },
      { title: 'Hire me', body: 'Enterprise platform engineering, Salesforce and OmniStudio. On contract.', cta: 'See my work', href: path('en', 'work') },
    ],
    labLine: 'The tools I build and use are open on GitHub.',
    labCta: 'See the lab',
    artLine: 'I also write transmedia fiction, and make music as a hobby.',
    artCta: 'See the art',
    proofTitle: 'From people I’ve worked with',
    proofSource: 'Published on LinkedIn',
  },
  es: {
    title: 'Carlos Rendón — Ingeniero de IA aplicada: MCP y agentes',
    description: 'Meto la IA dentro del proceso en el que tu gente ya trabaja, con gobernanza, medición y alguien que responde por cada decisión. Brisbane o remoto.',
    eyebrow: 'Brisbane · remoto · español e inglés',
    h1: 'Que la IA trabaje dentro de tu proceso, no al lado.',
    lede: 'Entiendo la arquitectura, el negocio y a la persona que lo va a usar. Construyo con gobernanza, medición y alguien que responde por cada decisión.',
    photoAlt: 'Carlos Rendón sonriendo en el escritorio de una oficina abierta, con las manos entrelazadas bajo el mentón.',
    ctaSubject: 'Consulta de proyecto',
    routesTitle: '¿Qué te trae por aquí?',
    routes: [
      { title: 'Llevar IA a tu equipo', body: 'Integro la IA a tus procesos: qué automatiza la máquina, qué decide una persona, cómo se mide. En concreto: MCP, memoria y orquestación de agentes. La primera conversación es gratis.', cta: 'Ver consultoría', href: path('es', 'consulting') },
      { title: 'Contratarme', body: 'Ingeniería de plataformas empresariales, Salesforce y OmniStudio. Por contrato.', cta: 'Ver mi trabajo', href: path('es', 'work') },
    ],
    labLine: 'Las herramientas que construyo y uso están abiertas en GitHub.',
    labCta: 'Ver el laboratorio',
    artLine: 'También escribo ficción transmedia y hago música por afición.',
    artCta: 'Ver el arte',
    proofTitle: 'De la gente con la que he trabajado',
    proofSource: 'Publicadas en LinkedIn',
  },
}[lang];
---

<Base lang={lang} page="" title={copy.title} description={copy.description} jsonLd={personJsonLd(lang)}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">{copy.eyebrow}</span>
        <h1 class="measure">{copy.h1}</h1>
        <p class="lede">{copy.lede}</p>
        <div class="btn-row">
          <ChatButton label={ui[lang].chat.cta} subject={copy.ctaSubject} />
          <a class="btn btn-ghost" href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>
      <picture class="hero-photo">
        <source srcset="/images/carlos-portrait.webp" type="image/webp" />
        <img src="/images/carlos-portrait.jpg" alt={copy.photoAlt} width="680" height="850" fetchpriority="high" />
      </picture>
    </div>
  </section>

  <section aria-labelledby="routes-title">
    <div class="wrap">
      <h2 id="routes-title">{copy.routesTitle}</h2>
      <div class="grid two">
        {
          copy.routes.map((r) => (
            <a class="card route" href={r.href}>
              <h3>{r.title}</h3>
              <p>{r.body}</p>
              <span class="card-link">{r.cta}</span>
            </a>
          ))
        }
      </div>
      <div class="side-lines">
        <p>{copy.labLine} <a class="card-link" href={path(lang, 'lab')}>{copy.labCta}</a></p>
        <p>{copy.artLine} <a class="card-link" href={path(lang, 'art')}>{copy.artCta}</a></p>
      </div>
    </div>
  </section>

  {
    testimonials.length > 0 && (
      <section aria-labelledby="proof-title">
        <div class="wrap">
          <h2 id="proof-title">{copy.proofTitle}</h2>
          <p class="proof-source">
            <a href={SITE.linkedin} target="_blank" rel="noopener">{copy.proofSource}</a>
          </p>
          <div class="grid two">
            {testimonials.map((t) => (
              <figure class="card quote">
                <blockquote>{t.quote[lang]}</blockquote>
                <figcaption class="card-foot">
                  <strong>{t.name}</strong>
                  <span class="machine">{t.role[lang]}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }


  <section>
    <div class="wrap">
      <Newsletter lang={lang} />
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }
  .hero-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: center;
  }
  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-photo {
      max-width: 20rem;
    }
  }
  .two {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  /* Secondary doors, under the two routes that sell. The rule and the shared
     column track keep them from reading as text that fell out of a card. */
  .side-lines {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 0.9rem 1.25rem;
    margin-top: 2.75rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.95rem;
  }
  .side-lines p {
    margin: 0;
  }
  .side-lines .card-link {
    color: var(--ink);
    white-space: nowrap;
  }
  .proof-source {
    font-family: var(--font-machine);
    font-size: 0.8rem;
    color: var(--muted);
    margin: -0.5rem 0 1.5rem;
  }
  .quote {
    margin: 0;
  }
  .quote blockquote {
    margin: 0;
    font-family: var(--font-human);
    font-size: 1.15rem;
    line-height: 1.5;
  }
  .quote figcaption {
    display: block;
  }
  .quote figcaption strong {
    display: block;
    font-weight: 600;
  }
  .hero-photo img {
    border-radius: 14px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 15%;
    width: 100%;
  }
  .route {
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .route:hover {
    border-color: var(--accent);
  }
  .route .card-link {
    margin-top: auto;
  }
  .three {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 2rem;
  }
  .muted {
    color: var(--muted);
  }
</style>
