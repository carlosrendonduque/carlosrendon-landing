---
import Base from '../../layouts/Base.astro';
import Newsletter from '../../components/Newsletter.astro';
import ChatButton from '../../components/ChatButton.astro';
import { SITE } from '../../site';
import { path, ui, staticLangPaths, type Lang } from '../../i18n/ui';
import { personJsonLd } from '../../data/person';
import { testimonials } from '../../data/testimonials';

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;

const copy = {
  en: {
    title: 'Carlos Rendón — Applied AI engineer: MCP, memory, agents',
    description: 'I connect AI to the systems you already run: the repetitive work does itself and your team keeps the decisions. MCP servers, memory and agent orchestration, with human approval.',
    eyebrow: 'Brisbane · remote · English & Spanish',
    h1: 'Keep the decisions. Let go of the rest.',
    lede: 'I connect AI to the systems you already run: the repetitive work does itself, and your team keeps what needs judgement.',
    available: 'Available for contracts now',
    photoAlt: 'Carlos Rendón smiling at a desk in an open-plan office, hands clasped under his chin.',
    ctaSubject: 'Project enquiry',
    routesTitle: 'What brings you here?',
    routes: [
      { title: 'Bring AI into your team', body: 'Agentic architecture on top of what you already run: MCP, memory and orchestration. The first conversation is free.', cta: 'See consulting', href: path('en', 'consulting') },
      { title: 'Hire me', body: 'Enterprise platform engineering, Salesforce and OmniStudio. On contract.', cta: 'See my work', href: path('en', 'work') },
    ],
    labLine: 'The tools I build and use are open on GitHub.',
    labCta: 'See the lab',
    artLine: 'I also write transmedia fiction and produce music.',
    artCta: 'See the art',
    proofTitle: 'From people I’ve worked with',
    proofSource: 'Published on LinkedIn',
    machine: 'AI proposes,',
    human: 'the human decides.',
    thesis: [
      ['Enterprise', 'AI goes into systems already in production; whoever answers for them still decides.'],
      ['AI tools', 'Agents propose; a person approves what matters.'],
      ['Fiction and music', 'AI as a character, and as raw material I shape by hand.'],
    ],
  },
  es: {
    title: 'Carlos Rendón — Ingeniero de IA aplicada: MCP y agentes',
    description: 'Conecto la IA a los sistemas que ya tienes: el trabajo repetitivo se hace solo y tu equipo se queda con las decisiones. Servidores MCP, memoria y orquestación de agentes, con aprobación humana.',
    eyebrow: 'Brisbane · remoto · español e inglés',
    h1: 'Quédate con las decisiones. Suelta el resto.',
    lede: 'Conecto la IA a los sistemas que ya tienes: el trabajo repetitivo se hace solo y tu equipo se queda con lo que exige criterio.',
    available: 'Disponible para contratos desde ya',
    photoAlt: 'Carlos Rendón sonriendo en el escritorio de una oficina abierta, con las manos entrelazadas bajo el mentón.',
    ctaSubject: 'Consulta de proyecto',
    routesTitle: '¿Qué te trae por aquí?',
    routes: [
      { title: 'Llevar IA a tu equipo', body: 'Arquitectura agéntica sobre lo que ya tienes corriendo: MCP, memoria y orquestación. La primera conversación es gratis.', cta: 'Ver consultoría', href: path('es', 'consulting') },
      { title: 'Contratarme', body: 'Ingeniería de plataformas empresariales, Salesforce y OmniStudio. Por contrato.', cta: 'Ver mi trabajo', href: path('es', 'work') },
    ],
    labLine: 'Las herramientas que construyo y uso están abiertas en GitHub.',
    labCta: 'Ver el laboratorio',
    artLine: 'También escribo ficción transmedia y produzco música.',
    artCta: 'Ver el arte',
    proofTitle: 'De la gente con la que he trabajado',
    proofSource: 'Publicadas en LinkedIn',
    machine: 'La IA propone,',
    human: 'el humano decide.',
    thesis: [
      ['Empresa', 'La IA entra a sistemas que ya están en producción; quien responde por ellos sigue decidiendo.'],
      ['Herramientas de IA', 'Los agentes proponen; una persona aprueba lo que importa.'],
      ['Ficción y música', 'La IA como personaje, y como materia prima que trabajo a mano.'],
    ],
  },
}[lang];
---

<Base lang={lang} page="" title={copy.title} description={copy.description} jsonLd={personJsonLd(lang)}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">{copy.eyebrow}</span>
        <h1 class="measure">{copy.h1}</h1>
        <p class="lede">{copy.lede}</p>
        <p class="availability"><span aria-hidden="true"></span>{copy.available}</p>
        <div class="btn-row">
          <ChatButton label={ui[lang].chat.cta} subject={copy.ctaSubject} />
          <a class="btn btn-ghost" href={SITE.linkedin}>LinkedIn</a>
        </div>
      </div>
      <picture class="hero-photo">
        <source srcset="/images/carlos-portrait.webp" type="image/webp" />
        <img src="/images/carlos-portrait.jpg" alt={copy.photoAlt} width="680" height="850" fetchpriority="high" />
      </picture>
    </div>
  </section>

  <section aria-labelledby="routes-title">
    <div class="wrap">
      <h2 id="routes-title">{copy.routesTitle}</h2>
      <div class="grid two">
        {
          copy.routes.map((r) => (
            <a class="card route" href={r.href}>
              <h3>{r.title}</h3>
              <p>{r.body}</p>
              <span class="card-link">{r.cta}</span>
            </a>
          ))
        }
      </div>
      <div class="side-lines">
        <p>{copy.labLine} <a class="card-link" href={path(lang, 'lab')}>{copy.labCta}</a></p>
        <p>{copy.artLine} <a class="card-link" href={path(lang, 'art')}>{copy.artCta}</a></p>
      </div>
    </div>
  </section>

  {
    testimonials.length > 0 && (
      <section aria-labelledby="proof-title">
        <div class="wrap">
          <h2 id="proof-title">{copy.proofTitle}</h2>
          <p class="proof-source">
            <a href={SITE.linkedin}>{copy.proofSource}</a>
          </p>
          <div class="grid two">
            {testimonials.map((t) => (
              <figure class="card quote">
                <blockquote>{t.quote[lang]}</blockquote>
                <figcaption class="card-foot">
                  <strong>{t.name}</strong>
                  <span class="machine">{t.role[lang]}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section aria-labelledby="thesis-title">
    <div class="wrap">
      <h2 id="thesis-title" class="thesis">
        <span class="thesis-machine">{copy.machine}</span>
        <span class="thesis-human">{copy.human}</span>
      </h2>
      <div class="grid three">
        {
          copy.thesis.map(([h, p]) => (
            <div>
              <h3>{h}</h3>
              <p class="muted">{p}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <Newsletter lang={lang} />
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }
  .hero-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: center;
  }
  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-photo {
      max-width: 20rem;
    }
  }
  /* The thesis is the brand line, so it heads the section that demonstrates it
     rather than the hero, where the offer has to come first. */
  .thesis {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
  }
  .thesis-machine {
    font-family: var(--font-machine);
    font-size: 0.55em;
    font-weight: 400;
    color: var(--muted);
    letter-spacing: 0;
  }
  .thesis-machine::after {
    content: '▍';
    color: var(--accent);
    margin-left: 0.15em;
    animation: blink 1.1s steps(1) 4 forwards;
  }
  .thesis-human {
    font-style: italic;
  }
  @keyframes blink {
    50%,
    100% {
      opacity: 0;
    }
  }
  /* auto-fill would leave an empty third track when a row holds two cards. */
  .two {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  /* Secondary doors, under the two routes that sell. The rule and the shared
     column track keep them from reading as text that fell out of a card. */
  .side-lines {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 0.9rem 1.25rem;
    margin-top: 2.75rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.95rem;
  }
  .side-lines p {
    margin: 0;
  }
  .side-lines .card-link {
    color: var(--ink);
    white-space: nowrap;
  }
  .proof-source {
    font-family: var(--font-machine);
    font-size: 0.8rem;
    color: var(--muted);
    margin: -0.5rem 0 1.5rem;
  }
  .quote {
    margin: 0;
  }
  .quote blockquote {
    margin: 0;
    font-family: var(--font-human);
    font-size: 1.15rem;
    line-height: 1.5;
  }
  .quote figcaption {
    display: block;
  }
  .quote figcaption strong {
    display: block;
    font-weight: 600;
  }
  .hero-photo img {
    border-radius: 14px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 15%;
    width: 100%;
  }
  .availability {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-machine);
    font-size: 0.85rem;
    margin: 0.5rem 0 0;
  }
  .availability span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #2e9d5a;
    box-shadow: 0 0 0 3px color-mix(in srgb, #2e9d5a 25%, transparent);
  }
  .route {
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .route:hover {
    border-color: var(--accent);
  }
  .route .card-link {
    margin-top: auto;
  }
  .three {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 2rem;
  }
  .muted {
    color: var(--muted);
  }
</style>
