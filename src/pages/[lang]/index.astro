---
import Base from '../../layouts/Base.astro';
import Newsletter from '../../components/Newsletter.astro';
import ChatButton from '../../components/ChatButton.astro';
import { SITE } from '../../site';
import { path, ui, staticLangPaths, type Lang } from '../../i18n/ui';
import { personJsonLd } from '../../data/person';

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;

const copy = {
  en: {
    title: 'Carlos Rendón — AI proposes, the human decides',
    description: 'AI engineer for regulated platforms. Salesforce for the health and public sectors, and AI tools where a person makes the final call. Also a writer and music producer.',
    eyebrow: 'Brisbane · remote · English & Spanish',
    machine: 'AI proposes,',
    human: 'the human decides.',
    lede: 'I build Salesforce systems for the health and public sectors, and AI tools where a person makes the final call.',
    available: 'Available for contracts now',
    photoAlt: 'Carlos Rendón smiling in his home studio, wearing headphones and playing a guitar.',
    routesTitle: 'What brings you here?',
    routes: [
      { title: 'Hire me', body: 'Salesforce, OmniStudio and applied AI. Contract or permanent.', cta: 'See my work', href: path('en', 'work') },
      { title: 'Bring AI into your team', body: 'MCP, retrieval and agents with human approval. Start with a free scoping chat.', cta: 'See consulting', href: path('en', 'consulting') },
      { title: 'Collaborate on art', body: 'Transmedia fiction, interactive stories and music.', cta: 'See the art', href: path('en', 'art') },
    ],
    facts: [
      ['Health & public sector', 'Salesforce platforms where errors reach real people'],
      ['8 certifications', 'Salesforce, including OmniStudio Developer and Consultant'],
      ['AI tools in daily use', 'my own MCP server, retrieval pipeline and writing editor'],
    ],
    thesisTitle: 'One idea, three places',
    thesis: [
      ['Enterprise', 'Systems that fail safely and hand over cleanly.'],
      ['AI tools', 'Agents propose; a person approves what matters.'],
      ['Fiction and music', 'AI as a character, and as raw material I shape by hand.'],
    ],
  },
  es: {
    title: 'Carlos Rendón — La IA propone, el humano decide',
    description: 'Ingeniero de IA para plataformas reguladas. Salesforce para los sectores salud y público, y herramientas de IA donde una persona tiene la última palabra. También escritor y productor musical.',
    eyebrow: 'Brisbane · remoto · español e inglés',
    machine: 'La IA propone,',
    human: 'el humano decide.',
    lede: 'Construyo sistemas Salesforce para los sectores salud y público, y herramientas de IA donde una persona tiene la última palabra.',
    available: 'Disponible para contratos desde ya',
    photoAlt: 'Carlos Rendón sonriendo en su estudio casero, con audífonos y tocando una guitarra.',
    routesTitle: '¿Qué te trae por aquí?',
    routes: [
      { title: 'Contratarme', body: 'Salesforce, OmniStudio e IA aplicada. Contrato o planta.', cta: 'Ver mi trabajo', href: path('es', 'work') },
      { title: 'Llevar IA a tu equipo', body: 'MCP, recuperación y agentes con aprobación humana. Empieza con un chat de diagnóstico gratis.', cta: 'Ver consultoría', href: path('es', 'consulting') },
      { title: 'Colaborar en arte', body: 'Ficción transmedia, historias interactivas y música.', cta: 'Ver el arte', href: path('es', 'art') },
    ],
    facts: [
      ['Salud y sector público', 'plataformas Salesforce donde los errores le llegan a personas reales'],
      ['8 certificaciones', 'de Salesforce, entre ellas OmniStudio Developer y Consultant'],
      ['Herramientas de IA en uso diario', 'mi propio servidor MCP, pipeline de recuperación y editor'],
    ],
    thesisTitle: 'Una idea, tres lugares',
    thesis: [
      ['Empresa', 'Sistemas que fallan de forma segura y se entregan limpios.'],
      ['Herramientas de IA', 'Los agentes proponen; una persona aprueba lo que importa.'],
      ['Ficción y música', 'La IA como personaje, y como materia prima que trabajo a mano.'],
    ],
  },
}[lang];
---

<Base lang={lang} page="" title={copy.title} description={copy.description} jsonLd={personJsonLd(lang)}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">{copy.eyebrow}</span>
        <h1 class="thesis">
          <span class="thesis-machine">{copy.machine}</span>
          <span class="thesis-human">{copy.human}</span>
        </h1>
        <p class="lede">{copy.lede}</p>
        <p class="availability"><span aria-hidden="true"></span>{copy.available}</p>
        <div class="btn-row">
          <ChatButton label={ui[lang].chat.cta} />
          <a class="btn btn-ghost" href={SITE.linkedin}>LinkedIn</a>
        </div>
      </div>
      <picture class="hero-photo">
        <source srcset="/images/carlos.webp" type="image/webp" />
        <img src="/images/carlos.jpg" alt={copy.photoAlt} width="1000" height="1173" fetchpriority="high" />
      </picture>
    </div>
  </section>

  <section aria-labelledby="routes-title">
    <div class="wrap">
      <h2 id="routes-title">{copy.routesTitle}</h2>
      <div class="grid">
        {
          copy.routes.map((r) => (
            <a class="card route" href={r.href}>
              <h3>{r.title}</h3>
              <p>{r.body}</p>
              <span class="card-link">{r.cta}</span>
            </a>
          ))
        }
      </div>
      <ul class="facts">
        {copy.facts.map(([n, d]) => <li><strong>{n}</strong><span>{d}</span></li>)}
      </ul>
    </div>
  </section>

  <section aria-labelledby="thesis-title">
    <div class="wrap">
      <h2 id="thesis-title">{copy.thesisTitle}</h2>
      <div class="grid three">
        {
          copy.thesis.map(([h, p]) => (
            <div>
              <h3>{h}</h3>
              <p class="muted">{p}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <Newsletter lang={lang} />
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }
  .hero-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: center;
  }
  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-photo {
      max-width: 20rem;
    }
  }
  .thesis {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
    margin-bottom: 1.5rem;
  }
  .thesis-machine {
    font-family: var(--font-machine);
    font-size: 0.5em;
    font-weight: 400;
    color: var(--muted);
    letter-spacing: 0;
  }
  .thesis-machine::after {
    content: '▍';
    color: var(--accent);
    margin-left: 0.15em;
    animation: blink 1.1s steps(1) 4 forwards;
  }
  .thesis-human {
    font-style: italic;
    animation: arrive 0.9s ease-out 0.5s both;
  }
  @keyframes blink {
    50%,
    100% {
      opacity: 0;
    }
  }
  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(0.15em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .hero-photo img {
    border-radius: 14px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 15%;
    width: 100%;
  }
  .availability {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-machine);
    font-size: 0.85rem;
    margin: 0.5rem 0 0;
  }
  .availability span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #2e9d5a;
    box-shadow: 0 0 0 3px color-mix(in srgb, #2e9d5a 25%, transparent);
  }
  .route {
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .route:hover {
    border-color: var(--accent);
  }
  .route .card-link {
    margin-top: auto;
  }
  .three {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 2rem;
  }
  .muted {
    color: var(--muted);
  }
</style>
